# Dependencies
node_modules/

# Build output — vendor directory is generated by `gulp vendor`
vendor/

# Compiled CSS (generated by `gulp css` from scss source)
css/*.min.css

# Compiled JS (generated by `gulp js`)
js/*.min.js

# OS artefacts
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files — never commit secrets
.env
.env.local
.env.*.local
